        </dependency>
        <dependency>
            <groupId>dev.zio</groupId>
            <artifactId>zio-test_3</artifactId>
            <version>2.1.26</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.zio</groupId>
            <artifactId>zio-test-sbt_3</artifactId>
