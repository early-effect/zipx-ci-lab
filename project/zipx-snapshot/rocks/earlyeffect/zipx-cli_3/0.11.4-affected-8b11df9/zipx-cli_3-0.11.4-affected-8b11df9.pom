    <organization>
        <name>Early Effect</name>
        <url>https://www.earlyeffect.rocks</url>
    </organization>
    <scm>
        <url>https://github.com/early-effect/zipx</url>
        <connection>scm:git@github.com:early-effect/zipx.git</connection>
    </scm>
    <developers>
        <developer>
            <id>russwyte</id>
            <name>Russ White</name>
            <url>https://github.com/russwyte</url>
            <email>356303+russwyte@users.noreply.github.com</email>
        </developer>
    </developers>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <info.versionScheme>early-semver</info.versionScheme>
    </properties>
    <dependencies>
